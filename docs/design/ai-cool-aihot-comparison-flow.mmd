  C3 -.补齐短板.-> T
  classDef hot fill:#E9D5FF,stroke:#A78BFA,color:#1E293B,stroke-width:2px
  classDef cool fill:#DBEAFE,stroke:#60A5FA,color:#1E293B,stroke-width:2px
  classDef target fill:#FEF3C7,stroke:#F59E0B,color:#1E293B,stroke-width:2px
